<section>
  <h2>Painel</h2>
  <dl id="panel">
    <dt>Confirmados</dt><dd data-metric="confirmed"><%= metrics.confirmed %></dd>
    <dt>Pendentes</dt><dd data-metric="pending"><%= metrics.pending %></dd>
    <dt>Check-ins</dt><dd data-metric="checkins"><%= metrics.checkins %></dd>
    <dt>Vagas disponíveis</dt><dd data-metric="available"><%= metrics.available %></dd>
    <dt>Receita</dt><dd data-metric="revenue"><%= revenueText %></dd>
    <dt>Estornados</dt><dd data-metric="refunded"><%= metrics.refunded %></dd>
  </dl>
</section>
