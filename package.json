{
  "name": "catraca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catraca — venda de ingressos para eventos pequenos (MVP construído em modo agente)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "sh scripts/up.sh",
    "down": "sh scripts/down.sh",
    "reset": "sh scripts/down.sh --volumes",
    "gates": "sh scripts/gates.sh",
    "flow": "bash scripts/evaluator-flow.sh",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "start": "node src/main.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
